digraph ER {
graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=1.3, fontname="Liberation Sans", label="Физическая модель данных БД barbershop (схема crm), нотация «вороньи лапки»", labelloc=t, fontsize=22, pad=0.4];
node [shape=plain, fontname="Liberation Sans", fontsize=11];
edge [fontname="Liberation Sans", fontsize=9, color="#555555", arrowsize=0.9];
