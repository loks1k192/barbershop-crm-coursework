<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn-02-cancel-reschedule" targetNamespace="http://barber-crm.local/bpmn" exporter="barber-crm docs generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_bpmn-02-cancel-reschedule">
    <bpmn:participant id="Pool_Client2" name="Клиент" />
    <bpmn:participant id="Pool_Shop2" name="Сеть барбершопов" processRef="Process_Pool_Shop2" />
    <bpmn:messageFlow id="m1" name="запрос" sourceRef="Pool_Client2" targetRef="a_start" />
    <bpmn:messageFlow id="m2" name="подтверждение" sourceRef="s_conf1" targetRef="Pool_Client2" />
    <bpmn:messageFlow id="m3" name="уведомление" sourceRef="s_notify" targetRef="Pool_Client2" />
    <bpmn:messageFlow id="m4" name="ответ" sourceRef="a_refuse" targetRef="Pool_Client2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Shop2" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Pool_Shop2">
      <bpmn:lane id="Lane_Admin2" name="Администратор">
        <bpmn:flowNodeRef>a_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_newtime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_end3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRM2" name="CRM-система">
        <bpmn:flowNodeRef>s_slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_resched</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_conf1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_end1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_hist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_end2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="a_start" name="Запрос на отмену или перенос">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_start_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="a_find" name="Найти запись клиента">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="a_gw" name="Что требуется?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_newtime" name="Согласовать новое время">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_reason" name="Указать причину отмены">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s_slots" name="Рассчитать свободные слоты (crm.free_slots)">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_resched" name="Перенести запись (crm.reschedule_appointment)">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="d1"><bpmn:targetRef>ds1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s_gw1" name="Перенос выполнен?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="s_conf1" name="Отправить подтверждение переноса">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="s_end1" name="Запись перенесена">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s_cancel" name="Отменить запись (crm.cancel_appointment)">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="d2"><bpmn:targetRef>ds2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s_gw2" name="Статус допускает отмену?">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_hist" name="Зафиксировать историю статусов и аудит (триггеры)">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="d3"><bpmn:targetRef>ds3</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="s_notify" name="Отправить уведомление об отмене">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="s_end2" name="Запись отменена, время освобождено">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="a_refuse" name="Сообщить клиенту, что отмена невозможна">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="a_end3" name="Отмена отклонена">
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="a_start" targetRef="a_find" />
    <bpmn:sequenceFlow id="f2" sourceRef="a_find" targetRef="a_gw" />
    <bpmn:sequenceFlow id="f3" name="перенос" sourceRef="a_gw" targetRef="a_newtime" />
    <bpmn:sequenceFlow id="f4" name="отмена" sourceRef="a_gw" targetRef="a_reason" />
    <bpmn:sequenceFlow id="f5" sourceRef="a_newtime" targetRef="s_slots" />
    <bpmn:sequenceFlow id="f6" sourceRef="s_slots" targetRef="s_resched" />
    <bpmn:sequenceFlow id="f7" sourceRef="s_resched" targetRef="s_gw1" />
    <bpmn:sequenceFlow id="f8" name="да" sourceRef="s_gw1" targetRef="s_conf1" />
    <bpmn:sequenceFlow id="f9" sourceRef="s_conf1" targetRef="s_end1" />
    <bpmn:sequenceFlow id="f10" name="нет: время занято (23P01)" sourceRef="s_gw1" targetRef="a_newtime" />
    <bpmn:sequenceFlow id="f11" sourceRef="a_reason" targetRef="s_cancel" />
    <bpmn:sequenceFlow id="f12" sourceRef="s_cancel" targetRef="s_gw2" />
    <bpmn:sequenceFlow id="f13" name="да" sourceRef="s_gw2" targetRef="s_hist" />
    <bpmn:sequenceFlow id="f14" sourceRef="s_hist" targetRef="s_notify" />
    <bpmn:sequenceFlow id="f15" sourceRef="s_notify" targetRef="s_end2" />
    <bpmn:sequenceFlow id="f16" name="нет: визит уже начат или завершён (CR002)" sourceRef="s_gw2" targetRef="a_refuse" />
    <bpmn:sequenceFlow id="f17" sourceRef="a_refuse" targetRef="a_end3" />
    <bpmn:dataStoreReference id="ds1" name="БД barbershop" dataStoreRef="DataStore_barbershop" />
    <bpmn:dataStoreReference id="ds2" name="БД barbershop" dataStoreRef="DataStore_barbershop" />
    <bpmn:dataStoreReference id="ds3" name="audit.audit_log, история статусов" dataStoreRef="DataStore_barbershop" />
  </bpmn:process>
  <bpmn:dataStore id="DataStore_barbershop" name="БД barbershop (PostgreSQL)" />
