<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn-01-booking-and-visit" targetNamespace="http://barber-crm.local/bpmn" exporter="barber-crm docs generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_bpmn-01-booking-and-visit">
    <bpmn:participant id="Pool_Client" name="Клиент" processRef="Process_Pool_Client" />
    <bpmn:participant id="Pool_Shop" name="Сеть барбершопов" processRef="Process_Pool_Shop" />
    <bpmn:messageFlow id="m1" name="запрос: мастер, услуги, дата" sourceRef="c_ask" targetRef="s_start" />
    <bpmn:messageFlow id="m2" name="свободные слоты" sourceRef="s_send_slots" targetRef="c_slots" />
    <bpmn:messageFlow id="m3" name="заявка" sourceRef="c_req" targetRef="s_req" />
    <bpmn:messageFlow id="m4" name="подтверждение" sourceRef="s_confirm" targetRef="c_ok" />
    <bpmn:messageFlow id="m5" name="отказ" sourceRef="s_refuse" targetRef="c_no" />
    <bpmn:messageFlow id="m6" name="напоминание" sourceRef="s_remind" targetRef="c_rem" />
    <bpmn:messageFlow id="m7" name="приход" sourceRef="c_come" targetRef="a_came" />
    <bpmn:messageFlow id="m8" name="оплата" sourceRef="c_pay" targetRef="a_calc" />
    <bpmn:messageFlow id="m9" name="чек, бонусы" sourceRef="s_receipt" targetRef="c_receipt" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Client" isExecutable="false">
    <bpmn:startEvent id="c_start" name="Нужна стрижка">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="c_choose" name="Выбрать мастера, услуги и дату">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_ask" name="Запросить свободное время">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="c_slots" name="Получить свободные слоты">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="c_pick" name="Выбрать слот, указать телефон и имя">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="c_req" name="Отправить заявку на запись">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="c_gw" name="">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c_ok" name="Подтверждение получено">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_ok_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_no" name="Отказ получен">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_no_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_rem" name="Напоминание получено">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_rem_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_time" name="Наступило время визита">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_time_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="c_come" name="Прийти в барбершоп">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="c_pay" name="Оплатить визит (деньги, бонусы)">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:receiveTask id="c_receipt" name="Получить чек и бонусы">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="c_end" name="Клиент обслужен">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="c_start" targetRef="c_choose" />
    <bpmn:sequenceFlow id="f2" sourceRef="c_choose" targetRef="c_ask" />
    <bpmn:sequenceFlow id="f3" sourceRef="c_ask" targetRef="c_slots" />
    <bpmn:sequenceFlow id="f4" sourceRef="c_slots" targetRef="c_pick" />
    <bpmn:sequenceFlow id="f5" sourceRef="c_pick" targetRef="c_req" />
    <bpmn:sequenceFlow id="f6" sourceRef="c_req" targetRef="c_gw" />
    <bpmn:sequenceFlow id="f7" sourceRef="c_gw" targetRef="c_ok" />
    <bpmn:sequenceFlow id="f8" sourceRef="c_gw" targetRef="c_no" />
    <bpmn:sequenceFlow id="f9" name="выбрать другое время" sourceRef="c_no" targetRef="c_pick" />
    <bpmn:sequenceFlow id="f10" sourceRef="c_ok" targetRef="c_rem" />
    <bpmn:sequenceFlow id="f11" sourceRef="c_rem" targetRef="c_time" />
    <bpmn:sequenceFlow id="f12" sourceRef="c_time" targetRef="c_come" />
    <bpmn:sequenceFlow id="f13" sourceRef="c_come" targetRef="c_pay" />
    <bpmn:sequenceFlow id="f14" sourceRef="c_pay" targetRef="c_receipt" />
    <bpmn:sequenceFlow id="f15" sourceRef="c_receipt" targetRef="c_end" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_Shop" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Pool_Shop">
      <bpmn:lane id="Lane_Admin" name="Администратор">
        <bpmn:flowNodeRef>a_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_came</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_noshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_end_ns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_calc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Barber" name="Барбер">
        <bpmn:flowNodeRef>b_serve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRM" name="CRM-система">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_send_slots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_t24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_start" name="Запрос свободного времени">
      <bpmn:outgoing>g1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_start_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="s_slots" name="Рассчитать свободные слоты (crm.free_slots)">
      <bpmn:incoming>g1</bpmn:incoming>
      <bpmn:outgoing>g2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="d1"><bpmn:targetRef>ds1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="s_send_slots" name="Слоты отправлены">
      <bpmn:incoming>g2</bpmn:incoming>
      <bpmn:outgoing>g3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_send_slots_def" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="s_req" name="Заявка получена">
      <bpmn:incoming>g3</bpmn:incoming>
      <bpmn:incoming>g8</bpmn:incoming>
      <bpmn:outgoing>g4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_req_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="s_book" name="Создать запись (crm.book_appointment)">
      <bpmn:incoming>g4</bpmn:incoming>
      <bpmn:outgoing>g5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="d2"><bpmn:targetRef>ds2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s_gw1" name="Запись создана?">
      <bpmn:incoming>g5</bpmn:incoming>
      <bpmn:outgoing>g6</bpmn:outgoing>
      <bpmn:outgoing>g7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="s_confirm" name="Отправить подтверждение">
      <bpmn:incoming>g6</bpmn:incoming>
      <bpmn:outgoing>g9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="s_refuse" name="Отправить отказ и другие слоты">
      <bpmn:incoming>g7</bpmn:incoming>
      <bpmn:outgoing>g8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="s_t24" name="За 24 ч до визита">
      <bpmn:incoming>g9</bpmn:incoming>
      <bpmn:outgoing>g10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="s_t24_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="s_remind" name="Отправить напоминание">
      <bpmn:incoming>g10</bpmn:incoming>
      <bpmn:outgoing>g11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="a_gw" name="">
      <bpmn:incoming>g11</bpmn:incoming>
      <bpmn:outgoing>h1</bpmn:outgoing>
      <bpmn:outgoing>h2</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="a_came" name="Клиент пришёл">
      <bpmn:incoming>h1</bpmn:incoming>
      <bpmn:outgoing>h3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_came_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="a_late" name="15 мин после начала">
      <bpmn:incoming>h2</bpmn:incoming>
      <bpmn:outgoing>h4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="a_late_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="a_noshow" name="Отметить неявку (no_show)">
      <bpmn:incoming>h4</bpmn:incoming>
      <bpmn:outgoing>h5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="a_end_ns" name="Неявка зафиксирована">
      <bpmn:incoming>h5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="a_begin" name="Начать визит (in_progress)">
      <bpmn:incoming>h3</bpmn:incoming>
      <bpmn:outgoing>h6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="b_serve" name="Оказать услуги">
      <bpmn:incoming>h6</bpmn:incoming>
      <bpmn:outgoing>h7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_calc" name="Принять оплату, учесть списание бонусов">
      <bpmn:incoming>h7</bpmn:incoming>
      <bpmn:incoming>h11</bpmn:incoming>
      <bpmn:outgoing>h8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s_complete" name="Завершить визит (crm.complete_ appointment)">
      <bpmn:incoming>h8</bpmn:incoming>
      <bpmn:outgoing>h9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="d3"><bpmn:targetRef>ds3</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s_gw2" name="Расчёт выполнен?">
      <bpmn:incoming>h9</bpmn:incoming>
      <bpmn:outgoing>h10</bpmn:outgoing>
      <bpmn:outgoing>h11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="s_receipt" name="Отправить чек и начисление бонусов">
      <bpmn:incoming>h10</bpmn:incoming>
      <bpmn:outgoing>h12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="s_end" name="Визит завершён">
      <bpmn:incoming>h12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="g1" sourceRef="s_start" targetRef="s_slots" />
    <bpmn:sequenceFlow id="g2" sourceRef="s_slots" targetRef="s_send_slots" />
    <bpmn:sequenceFlow id="g3" sourceRef="s_send_slots" targetRef="s_req" />
    <bpmn:sequenceFlow id="g4" sourceRef="s_req" targetRef="s_book" />
    <bpmn:sequenceFlow id="g5" sourceRef="s_book" targetRef="s_gw1" />
    <bpmn:sequenceFlow id="g6" name="да" sourceRef="s_gw1" targetRef="s_confirm" />
    <bpmn:sequenceFlow id="g7" name="нет (23P01 / CR003)" sourceRef="s_gw1" targetRef="s_refuse" />
    <bpmn:sequenceFlow id="g8" name="ждать новую заявку" sourceRef="s_refuse" targetRef="s_req" />
    <bpmn:sequenceFlow id="g9" sourceRef="s_confirm" targetRef="s_t24" />
    <bpmn:sequenceFlow id="g10" sourceRef="s_t24" targetRef="s_remind" />
    <bpmn:sequenceFlow id="g11" sourceRef="s_remind" targetRef="a_gw" />
    <bpmn:sequenceFlow id="h1" sourceRef="a_gw" targetRef="a_came" />
    <bpmn:sequenceFlow id="h2" sourceRef="a_gw" targetRef="a_late" />
    <bpmn:sequenceFlow id="h3" sourceRef="a_came" targetRef="a_begin" />
    <bpmn:sequenceFlow id="h4" sourceRef="a_late" targetRef="a_noshow" />
    <bpmn:sequenceFlow id="h5" sourceRef="a_noshow" targetRef="a_end_ns" />
    <bpmn:sequenceFlow id="h6" sourceRef="a_begin" targetRef="b_serve" />
    <bpmn:sequenceFlow id="h7" sourceRef="b_serve" targetRef="a_calc" />
    <bpmn:sequenceFlow id="h8" sourceRef="a_calc" targetRef="s_complete" />
    <bpmn:sequenceFlow id="h9" sourceRef="s_complete" targetRef="s_gw2" />
    <bpmn:sequenceFlow id="h10" name="да" sourceRef="s_gw2" targetRef="s_receipt" />
    <bpmn:sequenceFlow id="h11" name="нет (CR009): откат" sourceRef="s_gw2" targetRef="a_calc" />
    <bpmn:sequenceFlow id="h12" sourceRef="s_receipt" targetRef="s_end" />
    <bpmn:dataStoreReference id="ds1" name="БД barbershop" dataStoreRef="DataStore_barbershop" />
    <bpmn:dataStoreReference id="ds2" name="БД barbershop" dataStoreRef="DataStore_barbershop" />
    <bpmn:dataStoreReference id="ds3" name="БД barbershop" dataStoreRef="DataStore_barbershop" />
  </bpmn:process>
  <bpmn:dataStore id="DataStore_barbershop" name="БД barbershop (PostgreSQL)" />
