digraph "arch-3-core-components" {
graph [rankdir=TB, fontname="Liberation Sans", fontsize=22, labelloc=t, label=<<b>Архитектура. Уровень 3: компоненты сервиса core и серверная логика БД</b>>, nodesep=0.55, ranksep=0.8, pad=0.4, splines=spline, newrank=true ];
node [fontname="Liberation Sans", fontsize=13];
edge [fontname="Liberation Sans", fontsize=10, arrowsize=0.8, penwidth=1.3];
"gw" [label=<<b>API Gateway&#160;&#160;&#160;</b><br/><font point-size="10">[JWT]</font><br/><font point-size="10">Проверяет токен, передаёт X-User&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="white", color="#438dd5", margin="0.25,0.12"];
subgraph cluster_core { label=<<b>Сервис core (Go)</b>>; style="rounded"; color="#1168bd"; fontsize=15;
"router" [label=<<b>Router и middleware&#160;&#160;&#160;&#160;&#160;</b><br/><font point-size="10">[chi]</font><br/><font point-size="10">RequestID, логирование, recover, таймаут 30 с,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">X-User → контекст&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="black", color="#85bbf0", margin="0.25,0.12"];
"handlers" [label=<<b>HTTP-обработчики&#160;&#160;&#160;&#160;</b><br/><font point-size="10">[internal/api]</font><br/><font point-size="10">Справочники, клиенты, смены, записи, отчёты,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">импорт, аудит&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="black", color="#85bbf0", margin="0.25,0.12"];
"validate" [label=<<b>Валидация и параметры&#160;&#160;&#160;&#160;&#160;</b><br/><font point-size="10">[internal/api]</font><br/><font point-size="10">Формат полей, белый список сортировки,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">пагинация ≤ 100&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="black", color="#85bbf0", margin="0.25,0.12"];
"docs" [label=<<b>OpenAPI&#160;&#160;&#160;</b><br/><font point-size="10">[api/openapi.yaml]</font><br/><font point-size="10">/openapi.yaml и Swagger UI /docs&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="black", color="#85bbf0", margin="0.25,0.12"];
"store" [label=<<b>Слой данных (store)&#160;&#160;&#160;&#160;&#160;</b><br/><font point-size="10">[pgx]</font><br/><font point-size="10">Параметризованный SQL, фильтры, страницы,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">вызов функций БД&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="black", color="#85bbf0", margin="0.25,0.12"];
"reports" [label=<<b>Исполнитель отчётов&#160;&#160;&#160;&#160;&#160;</b><br/><font point-size="10">[embed sql/queries]</font><br/><font point-size="10">11 запросов, REPEATABLE READ READ ONLY&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="black", color="#85bbf0", margin="0.25,0.12"];
"tx" [label=<<b>Транзакции&#160;&#160;&#160;</b><br/><font point-size="10">[internal/db]</font><br/><font point-size="10">InTx: SET LOCAL crm.app_user, повтор при&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">40001/40P01&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="black", color="#85bbf0", margin="0.25,0.12"];
"apperr" [label=<<b>Маппинг ошибок&#160;&#160;&#160;&#160;</b><br/><font point-size="10">[internal/apperr]</font><br/><font point-size="10">SQLSTATE → HTTP: 23505/23P01→409,&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">23514/CR0xx→422, 42501→403&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="black", color="#85bbf0", margin="0.25,0.12"];
"kpi" [label=<<b>Планировщик KPI&#160;&#160;&#160;&#160;</b><br/><font point-size="10">[goroutine]</font><br/><font point-size="10">Периодический REFRESH MV&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="black", color="#85bbf0", margin="0.25,0.12"];
"cli" [label=<<b>CLI&#160;&#160;</b><br/><font point-size="10">[cmd/migrate, importer, concurrency-demo]</font><br/><font point-size="10">Миграции, пакетная загрузка, демонстрация&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="black", color="#85bbf0", margin="0.25,0.12"];
}
subgraph cluster_db { label=<<b>PostgreSQL 16 — БД barbershop</b>>; style="rounded,filled"; fillcolor="#f0f8f2"; color="#2f7d4f"; fontsize=15;
"tables" [label=<<b>Схема crm: 15 таблиц&#160;&#160;&#160;&#160;&#160;</b><br/><font point-size="10">[PK, FK, UNIQUE, CHECK, EXCLUDE gist]</font><br/><font point-size="10">Целостность и инварианты BR-1, BR-2, BR-6,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">BR-8&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#2f7d4f", fontcolor="white", color="#2f7d4f", margin="0.25,0.12"];
"triggers" [label=<<b>Триггеры&#160;&#160;&#160;</b><br/><font point-size="10">[PL/pgSQL]</font><br/><font point-size="10">Смены, переходы статусов, оплаты, отзывы,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">бонусы, уровни, updated_at, автосоздание 1:1&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#2f7d4f", fontcolor="white", color="#2f7d4f", margin="0.25,0.12"];
"funcs" [label=<<b>Функции бизнес-операций&#160;&#160;&#160;&#160;&#160;</b><br/><font point-size="10">[SECURITY DEFINER]</font><br/><font point-size="10">free_slots,&#160;&#160;&#160;</font><br/><font point-size="10">book/complete/cancel/reschedule_appointment,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">refresh_kpi&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#2f7d4f", fontcolor="white", color="#2f7d4f", margin="0.25,0.12"];
"views" [label=<<b>Представления и MV&#160;&#160;&#160;&#160;&#160;</b><br/><font point-size="10">v_appointment_details, v_client_stats,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">mv_barber_monthly_kpi&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#2f7d4f", fontcolor="white", color="#2f7d4f", margin="0.25,0.12"];
"audit" [label=<<b>Схема audit&#160;&#160;&#160;</b><br/><font point-size="10">[триггер audit.tg_audit]</font><br/><font point-size="10">audit_log: операция, старые/новые данные,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">пользователь&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#2f7d4f", fontcolor="white", color="#2f7d4f", margin="0.25,0.12"];
"staging" [label=<<b>Схема staging&#160;&#160;&#160;&#160;</b><br/><font point-size="10">[process_client_import]</font><br/><font point-size="10">Пакеты, сырые строки, журнал ошибок&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#2f7d4f", fontcolor="white", color="#2f7d4f", margin="0.25,0.12"];
"roles" [label=<<b>Роли&#160;&#160;</b><br/><font point-size="10">[crm_owner / crm_app / crm_readonly]</font><br/><font point-size="10">Минимальные привилегии, столбцовые права&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#2f7d4f", fontcolor="white", color="#2f7d4f", margin="0.25,0.12"];
}
"gw" -> "router" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">HTTP&#160;&#160;</font>>];
"router" -> "handlers" [color="#555555", fontcolor="#333333", style=solid];
"router" -> "docs" [color="#555555", fontcolor="#333333", style=solid];
"handlers" -> "validate" [color="#555555", fontcolor="#333333", style=solid];
"handlers" -> "store" [color="#555555", fontcolor="#333333", style=solid];
"handlers" -> "reports" [color="#555555", fontcolor="#333333", style=solid];
"handlers" -> "apperr" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">ошибки&#160;&#160;&#160;</font>>];
"store" -> "tx" [color="#555555", fontcolor="#333333", style=solid];
"reports" -> "views" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">SELECT&#160;&#160;&#160;</font>>];
"tx" -> "funcs" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">SELECT crm.book_appointment(...)&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font>>];
"tx" -> "tables" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">INSERT/UPDATE/DELETE&#160;&#160;&#160;&#160;&#160;</font>>];
"store" -> "staging" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">COPY + process_client_import&#160;&#160;&#160;&#160;&#160;&#160;</font>>];
"kpi" -> "funcs" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">crm.refresh_kpi()&#160;&#160;&#160;&#160;</font>>];
"cli" -> "tables" [color="#555555", fontcolor="#333333", style=dashed, label=<<font point-size="10">миграции, seed&#160;&#160;&#160;&#160;</font>>];
"tables" -> "triggers" [color="#555555", fontcolor="#333333", style=dashed, label=<<font point-size="10">срабатывают&#160;&#160;&#160;</font>>];
"funcs" -> "tables" [color="#555555", fontcolor="#333333", style=solid];
"triggers" -> "audit" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">запись аудита&#160;&#160;&#160;&#160;</font>>];
"views" -> "tables" [color="#555555", fontcolor="#333333", style=dashed];
"roles" -> "tables" [color="#555555", fontcolor="#333333", style=dotted, label=<<font point-size="10">GRANT&#160;&#160;</font>>];
}