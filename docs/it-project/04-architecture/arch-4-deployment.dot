"gw" -> "ms" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">gRPC&#160;&#160;</font>>];
"core" -> "pg" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">barbershop&#160;&#160;&#160;</font>>];
"mig" -> "pg" [color="#555555", fontcolor="#333333", style=solid];
"seed" -> "pg" [color="#555555", fontcolor="#333333", style=solid];
"ms" -> "pg" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">staff_db, …&#160;&#160;&#160;</font>>];
"ms" -> "infra" [color="#555555", fontcolor="#333333", style=solid];
"tests" -> "pg" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">временные БД&#160;&#160;&#160;&#160;</font>>];
"perf" -> "pg" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">barbershop_perf&#160;&#160;&#160;&#160;</font>>];
"obs" -> "gw" [color="#555555", fontcolor="#333333", style=dotted, label=<<font point-size="10">scrape&#160;&#160;&#160;</font>>];
}