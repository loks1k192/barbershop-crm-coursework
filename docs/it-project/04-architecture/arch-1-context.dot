digraph "arch-1-context" {
graph [rankdir=TB, fontname="Liberation Sans", fontsize=22, labelloc=t, label=<<b>Архитектура. Уровень 1: контекст системы (C4)</b>>, nodesep=0.55, ranksep=0.8, pad=0.4, splines=spline, newrank=true ];
node [fontname="Liberation Sans", fontsize=13];
edge [fontname="Liberation Sans", fontsize=10, arrowsize=0.8, penwidth=1.3];
"client" [label=<<b>Клиент&#160;&#160;&#160;</b><br/><font point-size="10">Записывается онлайн, приходит на визит,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">оплачивает, оставляет отзыв&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#08427b", fontcolor="white", color="#08427b", margin="0.25,0.12", width=2.6];
"admin" [label=<<b>Администратор филиала&#160;&#160;&#160;&#160;&#160;</b><br/><font point-size="10">Справочники, график смен, запись по телефону,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">расчёт, импорт клиентов&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#08427b", fontcolor="white", color="#08427b", margin="0.25,0.12", width=2.6];
"barber" [label=<<b>Барбер&#160;&#160;&#160;</b><br/><font point-size="10">Своё расписание, начало визита и оказание&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">услуг&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#08427b", fontcolor="white", color="#08427b", margin="0.25,0.12", width=2.6];
"manager" [label=<<b>Управляющий сетью&#160;&#160;&#160;&#160;</b><br/><font point-size="10">Выручка, загрузка мастеров, RFM, отток, KPI&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#08427b", fontcolor="white", color="#08427b", margin="0.25,0.12", width=2.6];
"crm" [label=<<b>Barber CRM&#160;&#160;&#160;</b><br/><font point-size="10">[веб-приложение + REST API + PostgreSQL]</font><br/><font point-size="10">CRM сети барбершопов: онлайн-запись,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">расписание, клиенты и лояльность, оплаты,&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font><br/><font point-size="10">аналитика, аудит&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#1168bd", fontcolor="white", color="#1168bd", margin="0.25,0.12", width=4];
"legacy" [label=<<b>Прежняя CRM / таблицы&#160;&#160;&#160;&#160;&#160;</b><br/><font point-size="10">[внешний источник]</font><br/><font point-size="10">Выгрузка клиентской базы в CSV&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#8a8a8a", fontcolor="white", color="#8a8a8a", margin="0.25,0.12"];
"ops" [label=<<b>Мониторинг&#160;&#160;&#160;</b><br/><font point-size="10">[Prometheus + Grafana]</font><br/><font point-size="10">Метрики сервисов&#160;&#160;&#160;&#160;</font>>, shape=box, style="rounded,filled", fillcolor="#8a8a8a", fontcolor="white", color="#8a8a8a", margin="0.25,0.12"];
{rank=same; client; admin; barber; manager;}
"client" -> "crm" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">запись, отмена, слоты (HTTPS)&#160;&#160;&#160;&#160;&#160;&#160;</font>>];
"admin" -> "crm" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">управление, расчёт, импорт (HTTPS)&#160;&#160;&#160;&#160;&#160;&#160;&#160;</font>>];
"barber" -> "crm" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">расписание, визиты (HTTPS)&#160;&#160;&#160;&#160;&#160;&#160;</font>>];
"manager" -> "crm" [color="#555555", fontcolor="#333333", style=solid, label=<<font point-size="10">отчёты и KPI (HTTPS)&#160;&#160;&#160;&#160;&#160;</font>>];
"legacy" -> "crm" [color="#555555", fontcolor="#333333", style=dashed, label=<<font point-size="10">CSV-файл&#160;&#160;&#160;</font>>];
"crm" -> "ops" [color="#555555", fontcolor="#333333", style=dashed, label=<<font point-size="10">/metrics&#160;&#160;&#160;</font>>];
"crm" -> "client" [color="#555555", fontcolor="#333333", style=dashed, label=<<font point-size="10">подтверждения, чеки, бонусы&#160;&#160;&#160;&#160;&#160;&#160;</font>>];
"legend" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="4" cellpadding="3"><tr><td colspan="2"><b>Обозначения</b></td></tr><tr><td bgcolor="#08427b" width="22"> </td><td align="left">Пользователь&#160;&#160;&#160;&#160;</td></tr><tr><td bgcolor="#1168bd" width="22"> </td><td align="left">Проектируемая система&#160;&#160;&#160;&#160;&#160;</td></tr><tr><td bgcolor="#8a8a8a" width="22"> </td><td align="left">Внешняя система&#160;&#160;&#160;&#160;</td></tr></table>>];
}